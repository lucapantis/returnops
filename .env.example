# ReturnOps environment — copy to `.env` and fill in real values.
# ReturnOps runs on PostgreSQL (Neon). Never commit the real `.env`.

# Pooled connection (Neon PgBouncer endpoint, host contains "-pooler").
# Used by the application at runtime via the Prisma driver adapter.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"

# Direct connection (no pooler). Used by the Prisma CLI for migrations,
# introspection and Studio — see prisma.config.ts. On Neon this is the same
# host without the "-pooler" segment.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"

# Optional: allow `npm run db:seed` to target a non-local, non-Neon host.
# The seed truncates the Return table first, so this stays off by default.
# RETURNOPS_SEED_ALLOW_ANY_HOST="true"
