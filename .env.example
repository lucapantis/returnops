# ReturnOps environment — copy to `.env` and fill in real values.
# ReturnOps runs on PostgreSQL (Neon). Never commit the real `.env`.

# Pooled connection (Neon PgBouncer endpoint, host contains "-pooler").
# Used by the application at runtime via the Prisma driver adapter.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"

# Direct connection (no pooler). Used by the Prisma CLI for migrations,
# introspection and Studio — see prisma.config.ts. On Neon this is the same
# host without the "-pooler" segment.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"

# Optional: allow `npm run db:seed` to target a non-local, non-Neon host.
# The seed truncates the Return table first, so this stays off by default.
# RETURNOPS_SEED_ALLOW_ANY_HOST="true"

# --- Authentication (Auth.js) ---------------------------------------------
# Run `npm run auth:init` to generate strong local values into `.env`
# automatically. These are PLACEHOLDERS only — never commit real values.

# Secret used to sign the session JWT / CSRF token. Generate with:
#   openssl rand -base64 32      (or `npx auth secret`)
AUTH_SECRET="REPLACE_WITH_32_BYTE_BASE64_SECRET"

# Canonical app URL. Locally this is http://localhost:3000. On Vercel it is
# set automatically; AUTH_TRUST_HOST is also honoured if you prefer.
AUTH_URL="http://localhost:3000"

# Seed accounts created by `npm run db:seed`. The ADMIN is the real operator
# account; the VIEWER is a read-only account (browse + CSV export). The separate
# public portfolio demo account is configured further below. Passwords must be
# >= 12 chars and are stored only as bcrypt hashes.
SEED_ADMIN_EMAIL="admin@returnops.local"
SEED_ADMIN_PASSWORD="REPLACE_WITH_STRONG_ADMIN_PASSWORD"
SEED_ADMIN_NAME="ReturnOps Admin"
SEED_VIEWER_EMAIL="viewer@returnops.local"
SEED_VIEWER_PASSWORD="REPLACE_WITH_STRONG_VIEWER_PASSWORD"
SEED_VIEWER_NAME="ReturnOps Viewer (demo)"

# Optional OPERATOR account. Created by the seed only when these are set;
# used by the automated tests and normal operations.
SEED_OPERATOR_EMAIL="operator@returnops.local"
SEED_OPERATOR_PASSWORD="REPLACE_WITH_STRONG_OPERATOR_PASSWORD"
SEED_OPERATOR_NAME="ReturnOps Operator"

# --- Public portfolio demo account --------------------------------------
# A dedicated, disposable VIEWER account for the public demo. It is always
# forced to the VIEWER role and is additionally denied CSV export, every
# mutation and the audit trail (enforced in lib/auth/guard.ts).
#
# These are PLACEHOLDERS — never commit real values. `npm run auth:init`
# generates a strong local password into the git-ignored `.env`.
#
#   - Runtime  : DEMO_USER_EMAIL + DEMO_USER_PASSWORD must both be set for
#                the "Try demo" button to appear on the login page. The
#                credentials stay server-side (no NEXT_PUBLIC_ prefix).
#   - Provision: `npm run demo:provision` upserts ONLY this one account.
#                It never seeds returns, runs migrations or touches other rows.
DEMO_USER_EMAIL="demo@returnops.local"
DEMO_USER_PASSWORD="REPLACE_WITH_STRONG_DEMO_PASSWORD"
DEMO_USER_NAME="ReturnOps Demo (viewer)"
